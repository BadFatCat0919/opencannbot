{
  "name": "cannbot-pro",
  "displayName": "CANNBot Pro for Copilot",
  "description": "Use CANNBOT Pro models (Claude Opus, GPT) directly in Copilot Chat model picker",
  "version": "0.1.0",
  "private": true,
  "publisher": "cannbot",
  "license": "MIT",
  "repository": "https://github.com/BadFatCat0919/opencannbot",
  "engines": {
    "vscode": "^1.116.0"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "cannbotpro",
        "displayName": "CANNBot Pro"
      }
    ],
    "configuration": {
      "title": "CANNBot Pro",
      "properties": {
        "cannbotpro.defaultModel": {
          "type": "string",
          "default": "claude-opus-4-8",
          "markdownDescription": "Default model ID (e.g. `claude-opus-4-8`, `gpt-5.4`)."
        },
        "cannbotpro.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Model temperature (0.0 - 2.0)."
        },
        "cannbotpro.maxTokens": {
          "type": "number",
          "default": 0,
          "description": "Max output tokens (0 = no limit)."
        }
      }
    },
    "commands": [
      {
        "command": "cannbotpro.setVk",
        "title": "CANNBot Pro: Set Virtual Key (VK)"
      },
      {
        "command": "cannbotpro.clearVk",
        "title": "CANNBot Pro: Clear Virtual Key (VK)"
      },
      {
        "command": "cannbotpro.status",
        "title": "CANNBot Pro: Show connection status"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
